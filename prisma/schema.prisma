generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  PARENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz
  image         String?
  password      String?
  timezone      String    @default("UTC")
  role          UserRole  @default(TEACHER)
  createdAt     DateTime  @default(now()) @db.Timestamptz
  accounts      Account[]
  sessions      Session[]
  teacher       Teacher?
  parent        Parent?
  practiceVideos PracticeVideo[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
}

model Teacher {
  id        String    @id @default(cuid())
  userId    String    @unique
  timezone  String    @default("UTC")
  createdAt DateTime  @default(now()) @db.Timestamptz
  lessons   Lesson[]
  students  Student[]
  pieces    Piece[]
  payments  PaymentMonth[]
  paymentTransactions PaymentTransaction[]
  families  Family[]
  parents   Parent[]
  practiceVideos PracticeVideo[]
  user      User      @relation(fields: [userId], references: [id])
  /// Teacher's own payment QR image (UPI / VietQR / QRIS / bank QR).
  /// Stored as a small base64 data URL (~10–100 KB); parents scan it with
  /// their banking app.
  paymentQrData String?
  paymentQrName String?
  /// Short note shown next to the QR, e.g. "Pay to BIDV · Nguyen Minh Anh —
  /// put student name + month in the payment note".
  paymentNote   String?
}

model Student {
  id         String          @id @default(cuid())
  teacherId  String
  name       String
  avatar     String?
  notes      String?
  lessonRate Int             @default(0)
  onlineLessonRate Int       @default(0)
  createdAt  DateTime        @default(now()) @db.Timestamptz
  lessons    Lesson[]
  teacher    Teacher         @relation(fields: [teacherId], references: [id])
  reports    MonthlyReport[]
  payments   PaymentMonth[]
  paymentTransactions PaymentTransaction[]
  familyMemberships FamilyMember[]
  parentLinks       ParentStudent[]
  practiceVideos    PracticeVideo[]

  @@index([teacherId])
}

model Piece {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  level       String?
  difficulty  Int?
  createdAt   DateTime @default(now()) @db.Timestamptz
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  lessons     Lesson[]

  @@index([teacherId])
}

model Lesson {
  id           String       @id @default(cuid())
  studentId    String
  teacherId    String
  date         DateTime     @db.Timestamptz
  duration     Int
  status       LessonStatus @default(PENDING)
  isOnline     Boolean      @default(false)
  rate         Int          @default(0)
  actualMin    Int?
  cancelReason String?
  note         String?
  // How well the lesson went, 1-5. Set only when the teacher chooses to rate
  // a COMPLETE lesson — null means "not rated" and is excluded from any
  // score-based ranking (some lessons/parents are deliberately left unrated).
  score        Int?
  pieceId      String?
  createdAt    DateTime     @default(now()) @db.Timestamptz
  piece        Piece?       @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, date])
  @@index([studentId, date])
  @@index([pieceId])
}

enum LessonStatus {
  PENDING
  COMPLETE
  CANCELLED
}

model MonthlyReport {
  id            String  @id @default(cuid())
  studentId     String
  month         Int
  year          Int
  summary       String?
  comments      String?
  nextMonthPlan String?
  tuitionNote   String?
  lessonMetadata Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, month, year])
}

model PaymentMonth {
  id             String   @id @default(cuid())
  studentId      String
  teacherId      String
  month          Int
  year           Int
  expectedAmount Int
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  student      Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([studentId, month, year])
  @@index([teacherId, month, year])
  @@index([studentId, year])
}

model PaymentTransaction {
  id             String   @id @default(cuid())
  paymentMonthId String
  studentId      String
  teacherId      String
  amount         Int
  method         String?
  note           String?
  date           DateTime @default(now()) @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  paymentMonth PaymentMonth @relation(fields: [paymentMonthId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, date])
  @@index([studentId, date])
  @@index([paymentMonthId])
}

// A named bundle of students (e.g. siblings, or a parent + child) so their
// monthly attendance/tuition can be printed on ONE combined sheet. Purely a
// reporting/billing convenience — individual students are unaffected everywhere
// else in the app.
model Family {
  id        String         @id @default(cuid())
  teacherId String
  name      String
  createdAt DateTime       @default(now()) @db.Timestamptz
  updatedAt DateTime       @updatedAt @db.Timestamptz
  teacher   Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members   FamilyMember[]

  @@index([teacherId])
}

model FamilyMember {
  id        String  @id @default(cuid())
  familyId  String
  studentId String
  position  Int     @default(0) // STT order on the combined sheet
  family    Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([familyId, studentId])
  @@index([studentId])
}


/// A parent login. Owns a User (role PARENT) and is linked to N students
/// (so one account can cover siblings).
model Parent {
  id         String    @id @default(cuid())
  userId     String    @unique          // the login — has role PARENT
  teacherId  String                     // which studio it belongs to
  createdAt  DateTime  @default(now()) @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentLinks ParentStudent[]

  @@index([teacherId])
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

enum VideoProvider {
  YOUTUBE
  DRIVE
  CLOUDINARY
  LINK
}

model PracticeVideo {
  id         String        @id @default(cuid())
  studentId  String
  teacherId  String
  postedById String        // User.id of whoever posted (parent — or teacher later)
  title      String
  note       String?
  url        String        // watch/embed URL, or Cloudinary secure_url
  provider   VideoProvider
  teacherComment String?   // teacher feedback, the core of the loop
  createdAt  DateTime      @default(now()) @db.Timestamptz

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  postedBy   User     @relation(fields: [postedById], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
  @@index([studentId, createdAt])
}
